{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Echo Voice",
  "version": "0.1.0",
  "identifier": "app.echovoice.desktop",
  "build": {"frontendDist": "ui"},
  "app": {
    "withGlobalTauri": true,
    "windows": [{"label":"main","title":"Echo Voice","width":520,"height":620,"minWidth":380,"minHeight":500}],
    "security": {"csp":"default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-src 'none'"}
  },
  "plugins": {"updater":{"pubkey":"","endpoints":[],"requireSignedVersion":true,"allowDowngrades":false}},
  "bundle": {"active":true,"targets":["app","dmg","deb"],"category":"Productivity","shortDescription":"Local meeting recordings and transcripts","publisher":"Samarth","macOS":{"minimumSystemVersion":"14.0"},"linux":{"deb":{"depends":["libwebkit2gtk-4.1-0","libgtk-3-0","xdg-utils"]}}}
}
