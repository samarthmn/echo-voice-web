# Echo binds to localhost. No cloud database or application account is required.
ECHO_BIND=127.0.0.1:3000
# Defaults to .echo-data in the project directory. Use an absolute path to customize.
# ECHO_DATA_DIR=/absolute/path/to/echo-voice-data

# Optional: Google Calendar read-only connection.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# Optional: Linux local Google Meet runner. Match the token in the runner environment.
ECHO_BOT_RUNNER_URL=http://127.0.0.1:8765
ECHO_BOT_TOKEN=
# The server and runner must use the same ECHO_DATA_DIR so deletion covers source audio.

# Optional ChatGPT notes: uses the official Codex helper and your plan's Codex allowance.
# Source builds install the pinned helper; prebuilt Linux bundles include it.
# Set an absolute binary path only to override automatic discovery (Codex 0.160.0).
# ECHO_CODEX_BIN=/absolute/path/to/codex
# Sign in from Local models. Echo keeps this login separate from other Codex apps.
# OPENAI_API_KEY is not used; subscription requests never fall back to API billing.

# Reverse proxies are unsupported by default. Only configure an exact trusted local origin.
# ECHO_ALLOWED_ORIGIN=https://your-explicit-local-origin.example
