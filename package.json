{
  "name": "echo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:assets": "node scripts/build-assets.ts",
    "build:extension": "node scripts/build-extension.ts",
    "package:extension": "node scripts/package-extension.ts",
    "test": "node --test \"tests/unit/**/*.test.ts\"",
    "test:speakers": "node scripts/smoke-speakers.ts",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/**/*.test.ts\"",
    "test:e2e": "node scripts/test-browser.ts",
    "format": "prettier --write \"{web,scripts,tests,extension}/**/*.{ts,json}\" \"tsconfig*.json\" \"extension/*.html\" \"public/*.html\" \"public/*.css\"",
    "format:check": "prettier --check \"{web,scripts,tests,extension}/**/*.{ts,json}\" \"tsconfig*.json\" \"extension/*.html\" \"public/*.html\" \"public/*.css\"",
    "typecheck": "node node_modules/typescript-native/lib/tsc.js -b",
    "knip": "knip",
    "typecheck:compat": "node node_modules/typescript/lib/tsc.js -b"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@scure/bip39": "2.2.0",
    "onnxruntime-node": "1.21.0",
    "onnxruntime-web": "1.22.0-dev.20250409-89f8206ba4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.55.0",
    "@types/chrome": "0.3.7",
    "esbuild": "^0.25.0",
    "knip": "6.44.0",
    "prettier": "3.6.2",
    "typescript": "6.0.3",
    "typescript-native": "npm:typescript@7.0.2",
    "@types/node": "22.18.0"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.18"
  }
}
